{
  "name": "naive-ui-template",
  "description": "Vue3/NaiveUI/UnoCSS Template",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "repository": {
    "url": "https://github.com/yuanlee301415/NaiveUI-Template"
  },
  "engines": {
    "node": "^22.13.0 || >=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build:only": "vite build",
    "analyze": "vite build --mode analyze",
    "preview": "vite build && vite preview",
    "preview:dist": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache --max-warnings 0",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "pnpm lint:check && pnpm type-check",
    "server": "pnpm exec json-server server/db.json5 --port 3001",
    "ver": "tsx build/scripts/update-internal-version.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@unocss/reset": "^66.13.0",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.21.1",
    "klona": "^2.0.6",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "tailwind-merge": "^3.7.1",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/mdi": "^1.2.3",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@unocss/preset-icons": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "~10.12.1",
    "globals": "^17.14.0",
    "json-server": "1.0.0-beta.3",
    "less": "^4.9.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "simple-git-hooks": "^2.14.0",
    "terser": "^5.51.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unocss": "^66.13.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.{vue,js,ts,mts,tsx}": [
      "eslint --fix --cache"
    ],
    "src/**/*.{vue,js,css,less,json,ts,mts,tsx}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  }
}
